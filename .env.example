# Copy to .env and adjust. Never commit .env.
CODEMIND_DATABASE_URL=sqlite:///./data/codemind.db
# For PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/codemind
CODEMIND_HOST=127.0.0.1
CODEMIND_PORT=8000
CODEMIND_DATA_DIR=./data

# Authentication. If CODEMIND_AUTH_REQUIRED=true, requests need "Authorization: Bearer <token>".
CODEMIND_AUTH_REQUIRED=false
CODEMIND_ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional remote model provider (leave blank to use deterministic local fallbacks).
# API keys are read from the environment only and are never stored in the database.
CODEMIND_LLM_PROVIDER=none
CODEMIND_LLM_MODEL=
CODEMIND_LLM_API_KEY=
CODEMIND_LLM_BASE_URL=
CODEMIND_EMBEDDING_PROVIDER=hashing

# Sandbox: "auto" prefers Docker when available, "docker", or "local" (restricted subprocess; weaker isolation).
CODEMIND_SANDBOX_MODE=auto
CODEMIND_SANDBOX_TIMEOUT_SECONDS=120
CODEMIND_SANDBOX_NETWORK=false
# Host-side restricted subprocess execution (NO filesystem/network isolation). Leave false unless you trust the repository.
CODEMIND_ALLOW_LOCAL_SANDBOX=false
CODEMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
